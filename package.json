{
  "name": "pi-sydbox",
  "version": "0.1.0",
  "private": true,
  "description": "syd (Landlock + seccomp) sandbox driver for pi: policy compiler, violation-to-grant mapper, approval dialogs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ci": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  }
}
